# ---------------------------------------------------------------------------
# borrowbox-server
# ---------------------------------------------------------------------------

# Libraries and credentials are managed in the UI (Settings -> BorrowBox
# libraries) and stored in Redis. The two variables below are only a first-boot
# seed for an existing deployment; once the registry is populated they are
# ignored, so a library removed in the UI stays removed. New installs can leave
# both unset.
#
# Optional seed, as JSON: {"name": "subdomain"}
BORROWBOX_LIBRARIES=

# Encrypts library credentials at rest in Redis. Required before credentials
# can be saved from the UI (Settings -> BorrowBox libraries).
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# A passphrase also works and is stretched with PBKDF2.
BORROWBOX_SECRET_KEY=

# Optional seed: {"library": {"username": "...", "password": "..."}}
# Credentials saved through the UI are encrypted and take precedence. Once every
# library is signed in through the UI, this can be removed entirely.
BORROWBOX_CREDENTIALS=

# Require this header (X-API-Key) on /api/ routes. Empty disables auth.
BORROWBOX_API_KEY=

BORROWBOX_REDIS_URL=redis://localhost:6379/0
BORROWBOX_YOTO_API_URL=http://localhost:8001

# ---------------------------------------------------------------------------
# yoto-server / shared Yoto settings
# ---------------------------------------------------------------------------

YOTO_BULK_YOTO_CLIENT_ID=
YOTO_BULK_YOTO_API_AUDIENCE=https://api.yotoplay.com
YOTO_BULK_REDIS_URL=redis://localhost:6379/0

# Audiobookshelf: the source of truth for library metadata.
YOTO_BULK_ABS_URL=
YOTO_BULK_ABS_TOKEN=
YOTO_BULK_ABS_LIBRARY_NAME=

# Only needed when Audiobookshelf sits behind Cloudflare Access.
YOTO_BULK_ABS_CF_ACCESS_CLIENT_ID=
YOTO_BULK_ABS_CF_ACCESS_CLIENT_SECRET=

# Optional, for AI series discovery.
YOTO_BULK_OPENAI_API_KEY=
